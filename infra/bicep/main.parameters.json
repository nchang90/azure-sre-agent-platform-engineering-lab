{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "uksouth"
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "resourceGroupName": {
      "value": "azure-cloud-commanders-${AZURE_ENV_NAME}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "adminPrincipalIds": {
      "value": [
        "3a168e0b-7a73-4dd0-a4f8-80045502775b"
      ]
    },
    "agentName": {
      "value": "${AGENT_NAME=sre-agent}"
    },
    "accessLevel": {
      "value": "${AGENT_ACCESS_LEVEL=Low}"
    },
    "actionMode": {
      "value": "${AGENT_ACTION_MODE=Review}"
    },
    "enableVnetIntegration": {
      "value": "${SRE_ENABLE_VNET=true}"
    },
    "deployFrontDoor": {
      "value": "${SRE_DEPLOY_FRONT_DOOR=false}"
    }
  }
}
